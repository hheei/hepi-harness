+import type { Context } from "@earendil-works/chord";
+import type { Transaction } from "../session/transaction.ts";
+import type { ConversationId } from "../types.ts";
+import type { ConversationControlState, ContinueConversationRequest, ContinueConversationResult, InboxControl, QueueMode, StopConversationRequest, StopConversationResult } from "./types.ts";
+/** What the control seam needs from the Harness host; the concrete host type is internal to harness.ts. */
+export type ControlHost = {
+    readonly harness: {
+        snapshot(token: unknown, conversationId: ConversationId, context: Context): Promise<unknown>;
+        commitWith<T>(change: (tx: Transaction) => T | Promise<T>, context: Context): Promise<T>;
+    };
+    readonly tasks: {
+        stopConversation<T>(conversationId: ConversationId, context: Context, change: (tx: Transaction) => Promise<{
+            readonly withdraw: boolean;
+            readonly value: T;
+        }>): Promise<{
+            readonly value: T;
+            readonly drain: "idle" | "stopping";
+        }>;
+        commitWhenIdle<T>(conversationId: ConversationId, context: Context, change: (tx: Transaction) => Promise<T>): Promise<{
+            readonly idle: false;
+        } | {
+            readonly idle: true;
+            readonly value: T;
+        }>;
+    };
+    now(): number;
+    queueModes(): {
+        readonly steeringMode: QueueMode;
+        readonly followUpMode: QueueMode;
+    };
+};
+/** The public projection of one conversation's control record. */
+export declare function controlView(control: InboxControl): ConversationControlState;
+/** The control record of one conversation, as a caller reads it. */
+export declare function readControl(host: ControlHost, conversationId: ConversationId, context: Context): Promise<ConversationControlState>;
+/**
+ * Hold a conversation in one commit: persist `held` with the trusted stop source and a new control revision, mark the
+ * ordinary live tasks for abort, and withdraw the queued inputs at this commit point.
+ */
+export declare function stopConversation(host: ControlHost, conversationId: ConversationId, request: StopConversationRequest, context: Context): Promise<StopConversationResult>;
+/**
+ * Resume a held conversation in one commit once the old stop's ordinary scope is idle; while it still drains, answer
+ * `stopping` with the held state and every queued input intact.
+ */
+export declare function continueConversation(host: ControlHost, conversationId: ConversationId, request: ContinueConversationRequest, context: Context): Promise<ContinueConversationResult>;
