+import { copyJson } from "@earendil-works/chord";
+import { admitSubmission } from "./submissions.js";
+import { applyBoundary, controlReceipt, draftControl, InboxDoc, inboxControl, initialControl, prepareBoundary, recordControlReceipt, } from "./inbox.js";
+import { LiveDoc } from "./live.js";
+import { startRun } from "./generation.js";
+/** A stored receipt as a detached value: a draft node cannot be read once its commit settled. */
+function receiptCopy(receipt) {
+    return copyJson(receipt, { omitUndefinedProperties: true });
+}
+/** The answer of a stored receipt, replaying its status and reason so a retry reads exactly like the first answer. */
+function receiptAnswer(receipt) {
+    return {
+        status: receipt.status,
+        ...(receipt.reason === undefined ? {} : { reason: receipt.reason }),
+        receipt: receiptCopy(receipt),
+    };
+}
+/** The public projection of one conversation's control record. */
+export function controlView(control) {
+    return {
+        state: control.state,
+        revision: control.revision,
+        ...(control.stopSource === undefined ? {} : { stopSource: control.stopSource }),
+        ...(control.stoppedAt === undefined ? {} : { stoppedAt: control.stoppedAt }),
+    };
+}
+/** Reject a control request an untyped caller got wrong, before any read or write. */
+function checkControlRequest(request, field) {
+    if (typeof request !== "object" || request === null)
+        throw new TypeError("A control request must be an object");
+    if (typeof request.requestId !== "string" || request.requestId.length === 0)
+        throw new TypeError("A control request needs a non-empty requestId");
+    const source = request[field];
+    if (source !== "user" && source !== "agent")
+        throw new TypeError(`${field} must be "user" or "agent", got ${String(source)}`);
+}
+/** The control record of one conversation, as a caller reads it. */
+export async function readControl(host, conversationId, context) {
+    const state = await host.harness.snapshot(InboxDoc, conversationId, context);
+    return controlView(state === undefined ? initialControl() : inboxControl(state));
+}
+/** Record a rejected control receipt and return its result. */
+function reject(control, operation, request, reason, now) {
+    const receipt = {
+        requestId: request.requestId,
+        operation,
+        status: "rejected",
+        reason,
+        revision: control.revision,
+        ...(operation === "stop" ? { stopSource: request.stopSource } : { caller: request.caller }),
+        at: now,
+    };
+    recordControlReceipt(control, receipt);
+    return { status: "rejected", reason, receipt, control: controlView(control) };
+}
+/**
+ * Hold a conversation: in one commit, persist `held` with the trusted stop source and a new control revision, mark the
+ * ordinary live tasks for abort, and withdraw the queued inputs at this commit point. A request this conversation
+ * already answered is returned unchanged; a later stop while already held keeps the inputs that arrived since and never
+ * downgrades a user stop to an agent one.
+ */
+export async function stopConversation(host, conversationId, request, context) {
+    checkControlRequest(request, "stopSource");
+    const now = host.now();
+    const result = await host.tasks.stopConversation(conversationId, context, async (tx) => {
+        const control = draftControl(await tx.doc(InboxDoc, conversationId));
+        const replay = controlReceipt(control, "stop", request.requestId);
+        if (replay !== undefined)
+            return { withdraw: false, value: { ...receiptAnswer(replay), control: controlView(control) } };
+        if (request.expectedControlRevision !== undefined && request.expectedControlRevision !== control.revision)
+            return { withdraw: false, value: reject(control, "stop", request, "revision_mismatch", now) };
+        if (control.state === "held") {
+            // The first stop withdrew the queued inputs; this one keeps what arrived since, and a user stop upgrades an
+            // agent stop while an agent stop never downgrades a user one.
+            if (request.stopSource === "user" && control.stopSource !== "user")
+                control.stopSource = "user";
+            // Every newly recorded stop intent advances the revision, so no pending continue outlives it.
+            control.revision += 1;
+            const receipt = {
+                requestId: request.requestId,
+                operation: "stop",
+                status: "held",
+                revision: control.revision,
+                stopSource: control.stopSource,
+                at: now,
+            };
+            recordControlReceipt(control, receipt);
+            return { withdraw: false, value: { status: "held", receipt, control: controlView(control) } };
+        }
+        control.state = "held";
+        control.stopSource = request.stopSource;
+        control.stoppedAt = now;
+        control.revision += 1;
+        const receipt = {
+            requestId: request.requestId,
+            operation: "stop",
+            status: "accepted",
+            revision: control.revision,
+            stopSource: request.stopSource,
+            at: now,
+        };
+        recordControlReceipt(control, receipt);
+        return { withdraw: true, value: { status: "accepted", receipt, control: controlView(control) } };
+    });
+    return { ...result.value, drain: result.drain };
+}
+/** Whether this caller may clear the recorded stop source: a user stop yields only to a trusted user continue. */
+function sourceLocked(control, request) {
+    return control.stopSource === "user" && request.caller !== "user";
+}
+/**
+ * What one continue intent decides against the committed control record. A request ID is not authorization: an intent
+ * this conversation already answered is answered again from its receipt, and one that is still pending is settled only
+ * by the caller that recorded it, under the same stop-source rule a first attempt meets.
+ */
+function decideContinue(control, request) {
+    const replay = controlReceipt(control, "continue", request.requestId);
+    if (replay !== undefined && replay.status !== "stopping")
+        return { kind: "receipt", receipt: replay };
+    if (replay !== undefined) {
+        // A pending intent may resume only the exact held state it observed: a later stop supersedes it.
+        if (control.state !== "held" || control.revision !== replay.revision)
+            return { kind: "reject", reason: "superseded" };
+        // The validation runs before the settlement this replay would perform, so a substituted caller cannot clear
+        // the stop or admit its own input.
+        if (sourceLocked(control, request))
+            return { kind: "refuse", reason: "source_locked", receipt: replay };
+        if (replay.caller !== request.caller)
+            return { kind: "refuse", reason: "caller_mismatch", receipt: replay };
+        return { kind: "pending", receipt: replay };
+    }
+    if (request.expectedControlRevision !== undefined && request.expectedControlRevision !== control.revision)
+        return { kind: "reject", reason: "revision_mismatch" };
+    if (control.state !== "held")
+        return { kind: "allowed" };
+    // A user stop is only cleared by a trusted user continue; an agent stop also accepts an explicit agent resume.
+    if (sourceLocked(control, request))
+        return { kind: "reject", reason: "source_locked" };
+    return { kind: "resume" };
+}
+/**
+ * Settle one continue intent inside a commit. With `canResume`, the drain has ended, so the held state is cleared, the
+ * optional new input is admitted natively, and whatever the held period queued is consumed from the same inbox in this
+ * same commit; without it, the intent is recorded as pending and the held state and every queued input stay.
+ */
+async function settleContinue(host, tx, conversationId, request, now, canResume) {
+    const control = draftControl(await tx.doc(InboxDoc, conversationId));
+    const decision = decideContinue(control, request);
+    if (decision.kind === "receipt")
+        return { ...receiptAnswer(decision.receipt), control: controlView(control) };
+    if (decision.kind === "reject")
+        return reject(control, "continue", request, decision.reason, now);
+    if (decision.kind === "refuse")
+        // A refused settlement writes nothing, so the request keeps the receipt its own caller recorded and can still be
+        // settled by that caller once it is the one asking.
+        return { status: "rejected", reason: decision.reason, receipt: decision.receipt, control: controlView(control) };
+    if (decision.kind === "allowed") {
+        const receipt = {
+            requestId: request.requestId,
+            operation: "continue",
+            status: "allowed",
+            revision: control.revision,
+            caller: request.caller,
+            at: now,
+        };
+        recordControlReceipt(control, receipt);
+        return { status: "allowed", receipt, control: controlView(control) };
+    }
+    if (!canResume) {
+        // A retry of an intent that is already pending reads the same receipt; only a first attempt records one.
+        if (decision.kind === "pending")
+            return { ...receiptAnswer(decision.receipt), control: controlView(control) };
+        const receipt = {
+            requestId: request.requestId,
+            operation: "continue",
+            status: "stopping",
+            revision: control.revision,
+            caller: request.caller,
+            at: now,
+        };
+        recordControlReceipt(control, receipt);
+        return { status: "stopping", receipt, control: controlView(control) };
+    }
+    control.state = "allowed";
+    delete control.stopSource;
+    delete control.stoppedAt;
+    control.revision += 1;
+    const modes = host.queueModes();
+    const input = request.input;
+    if (input !== undefined) {
+        // The native admission places the new input, or queues it behind what the held period kept and runs one final
+        // boundary over both, exactly as an ordinary idle submit does.
+        await admitSubmission(tx, conversationId, {
+            type: "input",
+            content: input.content,
+            ...(input.entry === undefined ? {} : { entry: input.entry }),
+            ...(input.requestId === undefined ? {} : { requestId: input.requestId }),
+            ...(input.whenBusy === undefined ? {} : { whenBusy: input.whenBusy }),
+        }, now, modes);
+    }
+    else {
+        // An empty continue still consumes the held period's queue: one final boundary, and no message when it is empty.
+        const boundary = await prepareBoundary(tx, conversationId, modes);
+        const live = await tx.doc(LiveDoc, conversationId);
+        const { users } = await applyBoundary(tx, boundary, "final", now);
+        if (users.length > 0)
+            await startRun(tx, conversationId, live, users);
+    }
+    const receipt = {
+        requestId: request.requestId,
+        operation: "continue",
+        status: "resumed",
+        revision: control.revision,
+        caller: request.caller,
+        at: now,
+    };
+    recordControlReceipt(control, receipt);
+    return { status: "resumed", receipt, control: controlView(control) };
+}
+/**
+ * Resume a held conversation with a trusted caller: while the old stop's ordinary scope still drains, record the
+ * pending intent and answer `stopping` with the held state and the input intact; once the native scope is idle, clear
+ * `held` and consume the same inbox in one commit. A request already answered is returned unchanged, and a stop that
+ * landed after a pending intent supersedes it.
+ */
+export async function continueConversation(host, conversationId, request, context) {
+    checkControlRequest(request, "caller");
+    const now = host.now();
+    const idle = await host.tasks.commitWhenIdle(conversationId, context, (tx) => settleContinue(host, tx, conversationId, request, now, true));
+    if (idle.idle)
+        return idle.value;
+    return host.harness.commitWith((tx) => settleContinue(host, tx, conversationId, request, now, false), context);
+}
