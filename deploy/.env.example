# Copy to deploy/.env (git-ignored) and fill in. Nothing here is baked into an image: the Dockerfiles take no
# build arguments and the runtime images carry no secrets. `docker compose` reads this file from the directory of the
# compose file, so deploy/.env is the default location for both profiles.

# Backend bearer token. Required: main.ts refuses a non-loopback bind without it. It is the backend's own credential;
# the Web origin is the client ingress, which presents HEPI_INGRESS_SERVICE_TOKEN instead (docs/client-runtime-release.md).
# Generate one, e.g. `openssl rand -hex 32`.
HEPI_AUTH_TOKEN=

# Images. Default to the local tag the Dockerfile builds; point it at a published GHCR image to skip building (see
# "Published images" in docs/container-deployment.md), for example:
#   HEPI_BACKEND_IMAGE=ghcr.io/<owner>/<repo>/backend:v0.1.0
HEPI_BACKEND_IMAGE=hepi-backend:local

# Host port. Both profiles read it: the host-network topology binds it directly, the split profile publishes it on the
# host's loopback and keeps 8787 inside the container.
HEPI_BACKEND_PORT=8787

# Workspace binding. All three are needed before the backend exposes a workspace to the UI; leave them empty for an
# offline backend with no execution host.
HEPI_WORKSPACE_ID=
HEPI_GATEWAY_ID=workstation
# Where the backend reaches the gateway. Under the host network this is the SSH reverse forward on the host's
# loopback; a bridge backend cannot reach that forward, so the split profile needs an address it can route to.
HEPI_GATEWAY_URL=http://127.0.0.1:18788
HEPI_GATEWAY_TOKEN=

# Durable state. Both files live on the hepi-state volume so a container replacement keeps conversations and the
# gateway call ledger.
HEPI_DB=/var/lib/hepi/hepi.sqlite
HEPI_SKILL_REPOSITORY=/var/lib/hepi/skill-repository.sqlite
# Project metadata (New Project, its folders and its one default). Same rule as the two files above: it lives on the
# hepi-state volume. Unset, it defaults to projects.sqlite beside HEPI_DB. Backend-only; remove the volume and the
# projects are gone while conversations remain.
HEPI_PROJECTS=/var/lib/hepi/projects.sqlite

# Web origin -> backend. This file configures the backend container only; the ingress reads its own env file
# (HEPI_INGRESS_BACKEND, http://127.0.0.1:<HEPI_BACKEND_PORT> for the host topology, http://backend:8787 on the split
# network). See docs/client-runtime-release.md.

# Model provider. Leave these commented out to keep the offline scripted `faux` provider; a provider id must
# arrive with its model, or startup fails by design. See docs/providers.md. Backend-only: the Web UI never sees them.
#HEPI_PROVIDER=deepseek
#HEPI_MODEL=deepseek-flash
#HEPI_PROVIDER_BASE_URL=
#HEPI_PROVIDER_API_KEY=

# Alternative registry: set HEPI_CONFIG_SOURCE=pi and PI_CODING_AGENT_DIR to read the backend host's Pi agent
# directory instead of the environment above. Backend-only. See docs/pi-config.md.
HEPI_CONFIG_SOURCE=
PI_CODING_AGENT_DIR=
