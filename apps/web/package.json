{
  "name": "@hepi/web",
  "private": true,
  "version": "0.10.0",
  "description": "Web UI for the pi coding agent",
  "homepage": "https://github.com/agegr/pi-web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agegr/pi-web.git"
  },
  "bugs": {
    "url": "https://github.com/agegr/pi-web/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "browserslist": [
    "chrome 111",
    "edge 111",
    "firefox 111",
    "safari 16.2",
    "ios_saf 16.2"
  ],
  "files": [
    "dist",
    "public",
    "package.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.vite.json",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test:terminal-close": "node e2e/ux-terminal-close.mjs",
    "test:terminal-fan-in": "node e2e/ux-terminal-fan-in.mjs",
    "test:terminal-session": "node e2e/ux-terminal-session.mjs",
    "test:stream-heartbeat-idle": "node e2e/stream-heartbeat-idle.mjs",
    "test:models-config": "node e2e/ux-models-config-save.mjs",
    "test:missing-model": "node e2e/ux-missing-model-recovery.mjs",
    "test:skills-install-feedback": "node ../server/scripts/skills-ui-smoke.ts --mode builtin",
    "test:skills-inventory-race": "node e2e/ux-skills-inventory-race.mjs",
    "test:skills-project-target": "node e2e/ux-skills-project-target.mjs",
    "test:capability-trust": "node e2e/ux-capability-trust.mjs",
    "test:extensions-panel": "node e2e/ux-extensions-panel.mjs",
    "test:extensions-selection": "node e2e/ux-extensions-selection.mjs",
    "test:mcp-tool-states": "node e2e/ux-mcp-tool-states.mjs",
    "test:mcp-acceptance": "node e2e/ux-mcp-acceptance.mjs",
    "test:truthfulness": "node e2e/ux-truthfulness.mjs",
    "test:skills": "node --test ../../packages/ui/src/lib/skill-inventory.test.mjs && node e2e/ux-skills-inventory-race.mjs && node e2e/ux-skills-project-target.mjs && node ../server/scripts/skills-ui-smoke.ts --mode builtin",
    "test:skills-sshd": "node ../server/scripts/skills-ui-smoke.ts --mode builtin --transport sshd",
    "test:visible-turns": "node e2e/ux-visible-turns.mjs",
    "test:windowed-transcript": "node e2e/ux-windowed-transcript.mjs",
    "test:chat-scroll": "node e2e/ux-chat-scroll.mjs",
    "test:window-experiment": "node e2e/window-experiment.mjs",
    "test:image-submit": "node e2e/ux-image-submit.mjs",
    "test:files-transfer": "node e2e/files-transfer.mjs",
    "test:file-surfaces": "node e2e/ux-file-surfaces.mjs",
    "test:file-failures": "node e2e/ux-file-failures.mjs",
    "test:child-recovery": "node e2e/ux-child-recovery.mjs",
    "test:docx-preview": "node e2e/ux-docx-preview.mjs",
    "test:nav-flicker": "node e2e/ux-nav-flicker.mjs",
    "test:navigation-retry": "node e2e/ux-navigation-retry.mjs",
    "test:raw-history-sidebar-focus": "node e2e/ux-raw-history-sidebar-focus.mjs",
    "test:history-rail": "node e2e/ux-history-rail.mjs",
    "test:rail-keyboard": "node e2e/ux-rail-keyboard.mjs",
    "test:history-scope": "node e2e/ux-history-scope.mjs",
    "test:references": "node e2e/ux-references.mjs",
    "test:references-acceptance": "node e2e/ux-references-acceptance.mjs",
    "test:nav-new-session": "node e2e/ux-nav-new-session.mjs",
    "test:session-auto-name": "node e2e/ux-session-auto-name.mjs",
    "test:session-delete": "node e2e/ux-session-delete.mjs",
    "test:session-fork": "node e2e/ux-session-fork.mjs",
    "test:session-search": "node e2e/ux-session-search.mjs",
    "test:worktree-picker": "node e2e/ux-worktree-picker.mjs",
    "test:submission-recovery": "node e2e/ux-submission-recovery.mjs",
    "test:new-project": "node e2e/ux-new-project.mjs",
    "test:project-removal": "node e2e/ux-project-removal.mjs",
    "test:ssh-project": "node e2e/ux-ssh-project.mjs",
    "test:agent-definitions": "node e2e/ux-agent-definitions.mjs",
    "test:project-routing": "node --test ../../packages/ui/src/lib/project-routing.test.mjs",
    "test:workspace-routing": "node e2e/ux-workspace-routing.mjs",
    "test:default-workspace": "node e2e/ux-default-workspace.mjs",
    "test:token-footer": "node e2e/ux-token-footer.mjs",
    "test:upstream": "node --test ../../packages/ui/src/components/ChatInput.test.mjs ../../packages/ui/src/components/MessageView.test.mjs",
    "upstream:version": "echo 0.10.0",
    "test:subagent-delegate": "node e2e/ux-subagent-delegate.mjs",
    "test:subtree-control": "node e2e/ux-subtree-control.mjs",
    "test:child-raw-history-fork": "node e2e/ux-child-raw-history-fork.mjs",
    "test:pending-item-controls": "node e2e/ux-pending-item-controls.mjs",
    "preview": "vite preview",
    "test:workbench-scope": "node e2e/ux-workbench-scope.mjs",
    "test:pwa-offline": "node e2e/ux-pwa-offline.mjs",
    "test:panel-ingress": "node e2e/ux-panel-ingress.mjs",
    "test:web-logout": "node e2e/ux-web-logout.mjs",
    "test:client-acceptance": "node e2e/ux-client-acceptance.mjs",
    "test:provider-acceptance": "node e2e/ux-provider-connection-acceptance.mjs",
    "test:native-acceptance": "node e2e/ux-native-acceptance.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.0.0",
    "@hepi/gateway": "workspace:*",
    "@hepi/protocol": "workspace:*",
    "@hepi/session": "workspace:*",
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "js-yaml": "^5.2.3",
    "micromark-util-types": "^2.0.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "undici": "8.11.0",
    "unified": "^11.0.5",
    "@hepi/ui": "workspace:*",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@tanstack/react-virtual": "3.14.19",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "ansi_up": "^6.0.6",
    "esbuild": "0.27.0",
    "eslint": "^9",
    "jiti": "^2.7.0",
    "katex": "^0.16.47",
    "mermaid": "^11.16.1",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-cjk-friendly": "^2.3.2",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5",
    "vite": "^8.3.4",
    "@vitejs/plugin-react": "^6.1.2",
    "@tailwindcss/vite": "^4.3.3"
  }
}
