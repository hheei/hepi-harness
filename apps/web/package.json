{
  "name": "@hepi/web",
  "private": true,
  "type": "module",
  "version": "0.10.0",
  "description": "Web UI for the pi coding agent",
  "homepage": "https://github.com/agegr/pi-web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agegr/pi-web.git"
  },
  "bugs": {
    "url": "https://github.com/agegr/pi-web/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "browserslist": [
    "chrome 111",
    "edge 111",
    "firefox 111",
    "safari 16.2",
    "ios_saf 16.2"
  ],
  "files": [
    "dist",
    "public",
    "package.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.vite.json",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test:terminal-close": "node e2e/terminal/ux-terminal-close.ts",
    "test:terminal-fan-in": "node e2e/terminal/ux-terminal-fan-in.ts",
    "test:terminal-session": "node e2e/terminal/ux-terminal-session.ts",
    "test:skills-install-feedback": "node ../server/scripts/skills-ui-smoke.ts --mode builtin",
    "test:skills-inventory-race": "node e2e/mcp-skills/ux-skills-inventory-race.ts",
    "test:skills-project-target": "node e2e/mcp-skills/ux-skills-project-target.ts",
    "test:capability-trust": "node e2e/auth-shell/ux-capability-trust.ts",
    "test:extensions-panel": "node e2e/mcp-skills/ux-extensions-panel.ts",
    "test:mcp-tool-states": "node e2e/mcp-skills/ux-mcp-tool-states.ts",
    "test:mcp-workflow": "node e2e/mcp-skills/ux-mcp-workflow.ts",
    "test:mcp-acceptance": "node e2e/mcp-skills/ux-mcp-acceptance.ts",
    "test:skills": "node --test ../../packages/ui/src/lib/skill-inventory.test.ts && node e2e/mcp-skills/ux-skills-inventory-race.ts && node e2e/mcp-skills/ux-skills-project-target.ts && node ../server/scripts/skills-ui-smoke.ts --mode builtin",
    "test:skills-sshd": "node ../server/scripts/skills-ui-smoke.ts --mode builtin --transport sshd",
    "test:visible-turns": "node e2e/history/ux-visible-turns.ts",
    "test:chat-scroll": "node e2e/chat/ux-chat-scroll.ts",
    "test:window-experiment": "node e2e/history/window-experiment.ts",
    "test:files-transfer": "node e2e/workbench-files/files-transfer.ts",
    "test:file-surfaces": "node e2e/workbench-files/ux-file-surfaces.ts",
    "test:file-failures": "node e2e/workbench-files/ux-file-failures.ts",
    "test:child-recovery": "node e2e/chat/ux-child-recovery.ts",
    "test:docx-preview": "node e2e/workbench-files/ux-docx-preview.ts",
    "test:navigation-retry": "node e2e/history/ux-navigation-retry.ts",
    "test:raw-history-sidebar-focus": "node e2e/history/ux-raw-history-sidebar-focus.ts",
    "test:history-rail": "node e2e/history/ux-history-rail.ts",
    "test:rail-keyboard": "node e2e/history/ux-rail-keyboard.ts",
    "test:history-scope": "node e2e/history/ux-history-scope.ts",
    "test:references": "node e2e/chat/ux-references.ts",
    "test:references-acceptance": "node e2e/chat/ux-references-acceptance.ts",
    "test:ssh-project": "node e2e/workbench-files/ux-ssh-project.ts",
    "test:project-routing": "node --test ../../packages/ui/src/lib/project-routing.test.ts",
    "test:token-footer": "node e2e/chat/ux-token-footer.ts",
    "test:composer-interaction": "node e2e/chat/ux-composer-interaction.ts",
    "test:message-copy": "node e2e/chat/ux-message-copy.ts",
    "test:conversation-lifetime": "node e2e/chat/ux-conversation-lifetime.ts",
    "test:conversation-lifetime-shell": "node e2e/chat/ux-conversation-lifetime-shell.ts",
    "test:upstream": "node --test ../../packages/ui/src/components/ChatInput.test.ts ../../packages/ui/src/components/MessageView.test.ts",
    "upstream:version": "echo 0.10.0",
    "test:subtree-control": "node e2e/chat/ux-subtree-control.ts",
    "preview": "vite preview",
    "test:workbench-scope": "node e2e/workbench-files/ux-workbench-scope.ts",
    "test:pwa-offline": "node e2e/auth-shell/ux-pwa-offline.ts",
    "test:panel-ingress": "node e2e/auth-shell/ux-panel-ingress.ts",
    "test:web-logout": "node e2e/auth-shell/ux-web-logout.ts",
    "test:client-acceptance": "node e2e/acceptance/ux-client-acceptance.ts",
    "test:provider-acceptance": "node e2e/acceptance/ux-provider-connection-acceptance.ts",
    "test:native-acceptance": "node e2e/acceptance/ux-native-acceptance.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.0.0",
    "@hepi/gateway": "workspace:*",
    "@hepi/protocol": "workspace:*",
    "@hepi/session": "workspace:*",
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "js-yaml": "^5.2.3",
    "micromark-util-types": "^2.0.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "undici": "8.11.0",
    "unified": "^11.0.5",
    "@hepi/ui": "workspace:*",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@tanstack/react-virtual": "3.14.19",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "ansi_up": "^6.0.6",
    "esbuild": "0.27.0",
    "eslint": "^9",
    "jiti": "^2.7.0",
    "katex": "^0.16.47",
    "mermaid": "^11.16.1",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-cjk-friendly": "^2.3.2",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5",
    "vite": "^8.3.4",
    "@vitejs/plugin-react": "^6.1.2",
    "@tailwindcss/vite": "^4.3.3"
  }
}
